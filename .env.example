# =============================================================================
#  ИС «ГрузПоток» — пример файла окружения
#  Скопируйте в .env и заполните значениями своего контура.
#  Переменные окружения имеют приоритет над содержимым файла.
# =============================================================================

# --- Основное ----------------------------------------------------------------
# Секретный ключ. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(50))"
FF_SECRET_KEY=замените-на-случайную-строку-не-менее-50-символов
FF_DEBUG=True
FF_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Для промышленного контура за HTTPS-прокси укажите домен со схемой:
# FF_CSRF_TRUSTED_ORIGINS=https://freightflow.example.ru

# --- База данных -------------------------------------------------------------
# sqlite   — локальная разработка, автотесты, демонстрационная сборка
# postgres — промышленный контур с расширением PostGIS
FF_DB_ENGINE=sqlite
FF_DB_PATH=data/freightflow.sqlite3

# Параметры PostgreSQL (используются при FF_DB_ENGINE=postgres)
FF_DB_NAME=freightflow
FF_DB_USER=freightflow
FF_DB_PASSWORD=
FF_DB_HOST=127.0.0.1
FF_DB_PORT=5432
FF_DB_CONN_MAX_AGE=60

# --- Кеш ---------------------------------------------------------------------
# Пусто — кеш в оперативной памяти процесса; для нескольких рабочих процессов
# укажите Redis: redis://127.0.0.1:6379/1
FF_REDIS_URL=
FF_ANALYTICS_CACHE_TTL=600

# --- Реквизиты проекта -------------------------------------------------------
FF_AUTHOR=Бухаров Родион Романович
FF_AUTHOR_ID=70232269
FF_PROJECT_NAME=ГрузПоток
FF_PROJECT_NAME_LATIN=FreightFlow

# --- Карта -------------------------------------------------------------------
FF_MAP_ZOOM=10
FF_MAP_MAX_FEATURES=5000

# --- Почта -------------------------------------------------------------------
# При пустом FF_EMAIL_HOST письма выводятся в консоль сервера.
FF_EMAIL_HOST=
FF_EMAIL_PORT=587
FF_EMAIL_USER=
FF_EMAIL_PASSWORD=
FF_EMAIL_TLS=True
FF_EMAIL_FROM=noreply@freightflow.local

# --- Прочее ------------------------------------------------------------------
FF_LOG_LEVEL=INFO
FF_PAGE_SIZE=25
FF_MAX_UPLOAD_MB=25
FF_EXPORT_RETENTION_DAYS=14
FF_SSL_REDIRECT=True
