msgid "Закладки на объекты, округа, участки сети и маршруты."
msgstr "Bookmarks for facilities, districts, network segments and routes."

msgid "Не удалось изменить закладку: некорректные параметры."
msgstr "Could not change the bookmark: invalid parameters."

msgid "Закладка убрана."
msgstr "Bookmark removed."

msgid "Добавлено в избранное."
msgstr "Added to favourites."

msgid "Вид сохранён."
msgstr "View saved."

msgid "Настроенные условия отбора. Сохраняются параметры, а не данные: при открытии выборка выполняется заново."
msgstr "Stored filter settings. Parameters are saved rather than data: the selection is re-run each time the view is opened."

msgid "Вид опубликован — доступ открыт по ссылке."
msgstr "View published — accessible by link."

msgid "Публичный доступ к виду закрыт."
msgstr "Public access to the view revoked."

msgid "Вид удалён."
msgstr "View deleted."

msgid "Группы округов, объектов и маршрутов для сопоставительного анализа."
msgstr "Groups of districts, facilities and routes for comparative analysis."

msgid "Файл отчёта ещё не сформирован"
msgstr "The report file has not been generated yet"

msgid "Файл отчёта удалён по истечении срока хранения"
msgstr "The report file was removed after the retention period"

msgid "Подписка оформлена."
msgstr "Subscription created."

msgid "Оповещение о дорожных событиях в выбранном округе с заданным порогом серьёзности."
msgstr "Notification of traffic incidents in the selected district above a given severity threshold."

msgid "Подписка удалена."
msgstr "Subscription removed."

msgid "Сообщения системы о событиях, подпадающих под ваши подписки."
msgstr "System messages about events matching your subscriptions."

msgid "Все уведомления отмечены как прочитанные."
msgstr "All notifications marked as read."

