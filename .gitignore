# Виртуальные окружения и зависимости
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.uv/

# Конфигурация контура
.env
.env.local

# Данные и артефакты выполнения.
#
# Исключается содержимое каталогов, а не сами каталоги: правило вида `logs/`
# заставляет Git не заходить внутрь, и последующее отрицание `!logs/.gitkeep`
# не срабатывает. При такой записи отметочные файлы сохраняют структуру
# каталогов в репозитории, а рабочие файлы в него не попадают.
logs/*
media/*
staticfiles/
*.log

# Кеш ответов Overpass. Объём измеряется десятками мегабайт, а данные
# восстанавливаются повторной загрузкой; в поставку входит уже
# наполненная база.
data/osm/*.json.gz
data/osm/*.part

# Выгрузка OpenStreetMap и собранные по ней тайлы графа дорог. Выгрузка
# весит около ста мегабайт, тайлы графа — больше; и то и другое
# восстанавливается по data/README.md одной командой.
data/routing/

# Служебное
.coverage
htmlcov/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Среды разработки
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Служебные файлы SQLite: журнал предзаписи и разделяемая память живут
# только во время работы процесса и к содержимому базы не относятся.
data/*.sqlite3-shm
data/*.sqlite3-wal

# ВАЖНО: файл демонстрационной базы SQLite намеренно НЕ исключён —
# он входит в поставку, чтобы систему можно было запустить сразу после
# клонирования репозитория (см. data/README.md).

# Отметочные файлы, сохраняющие структуру каталогов.
!logs/.gitkeep
!media/exports/.gitkeep

# Служебные файлы, не входящие в поставку.
# Сценарии формирования истории коммитов задним числом в проекте
# не используются: история набирается настоящей работой.
COMMITS.md
make-history.ps1
setup-history.ps1

# Отчёты расширения VS Code Counter — к проекту не относятся.
.VSCodeCounter/
