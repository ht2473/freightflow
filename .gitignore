# Виртуальные окружения и зависимости
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.uv/

# Конфигурация контура
.env
.env.local

# Данные и артефакты выполнения.
#
# Исключается содержимое каталогов, а не сами каталоги: правило вида `logs/`
# заставляет Git не заходить внутрь, и последующее отрицание `!logs/.gitkeep`
# не срабатывает. При такой записи отметочные файлы сохраняют структуру
# каталогов в репозитории, а рабочие файлы в него не попадают.
logs/*
media/*
staticfiles/
*.log

# Служебное
.coverage
htmlcov/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Среды разработки
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ВАЖНО: файл демонстрационной базы SQLite намеренно НЕ исключён —
# он входит в поставку, чтобы систему можно было запустить сразу после
# клонирования репозитория (см. data/README.md).

# Отметочные файлы, сохраняющие структуру каталогов.
!logs/.gitkeep
!media/exports/.gitkeep

# Служебные файлы, не входящие в поставку
COMMITS.md
make-history.ps1

# Отчёты расширения VS Code Counter — к проекту не относятся.
.VSCodeCounter/
