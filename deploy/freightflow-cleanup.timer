# Ежесуточный запуск очистки в ночные часы, когда нагрузка минимальна.
[Unit]
Description=Ежесуточная очистка выгрузок ИС «ГрузПоток»

[Timer]
OnCalendar=*-*-* 03:30:00
# Если сервер был выключен в назначенное время, задача выполнится при запуске.
Persistent=true
RandomizedDelaySec=15m

[Install]
WantedBy=timers.target
