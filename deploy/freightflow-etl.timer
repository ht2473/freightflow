# Ежечасная сверка регламента. Загрузка выполняется не каждый час, а только
# для тех наборов, у которых подошёл объявленный срок обновления.
[Unit]
Description=Сверка регламента загрузки данных ИС «ГрузПоток»

[Timer]
OnCalendar=*-*-* *:05:00
# Если сервер был выключен в назначенное время, сверка выполнится при запуске.
Persistent=true
RandomizedDelaySec=5m

[Install]
WantedBy=timers.target
